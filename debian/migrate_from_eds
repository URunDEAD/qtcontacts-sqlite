#! /bin/sh

set -e

BASE_DIR="$HOME/.local/share/evolution/addressbook"

for ADDR_DIR in "$BASE_DIR"/*; do

  echo "evaluating $ADDR_DIR"

  echo "checking if already migrated ..."
  # Skip if we already migrated
  [ -f "$ADDR_DIR/migrated_to_qtcontacts" ] && continue

  echo "checking if DB file available ..."
  # Skip if there is not DB file
  [ -f "$ADDR_DIR/contacts.db" ] || continue

  echo "Importing from $ADDR_DIR"
  # Import; the "col-2" stands for "local contacts collection"
  /usr/bin/eds_importer "$ADDR_DIR/contacts.db" "col-2"

  echo $? > "$ADDR_DIR/migrated_to_qtcontacts"

done
